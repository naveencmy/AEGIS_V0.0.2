# ==============================================================================
# AEGIS-NTRO Git Ignore Configuration
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Large Language Models & Embeddings
models/*.gguf
models/*.bin
models/*.safetensors
models/*.onnx
!models/.gitkeep

# Vector Stores, Databases & Checkpoints
*.sqlite3
*.sqlite3-journal
*.db
backend/data/chroma/
!backend/data/chroma/.gitkeep
chroma_db/
!chroma_db/.gitkeep
data/chroma/
!data/chroma/.gitkeep
backend/checkpoints/*.json
!backend/checkpoints/.gitkeep

# Raw Data Snapshots & Embedded Repositories
data/raw/
!data/raw/**/.gitkeep
data/sigma_repo/
data/uploads/
data/ingested_corpus.jsonl

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.agents/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Dumps
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
backend/tests/eval_results.json

# Node & Frontend Build Artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
package-lock.json

# Temp & Scratch Files
*.tmp
*.temp
scratch/
