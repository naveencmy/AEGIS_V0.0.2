# ══════════════════════════════════════════════════════════════════════════════
# AEGIS-NTRO v2.0 — Environment Configuration
# Sovereign AI-Driven Multi-Vendor Network Compliance Auditor
# Target: NTRO SIH26155 | Theme: Blockchain & Cybersecurity
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=AEGIS-NTRO
VERSION=2.0.0
DEBUG=false

# ── Database (PostgreSQL 16 + pgvector) ───────────────────────────────────────
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegis_ntro
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secure_pass_2026@localhost:5432/aegis_ntro

# ── LLM Reasoning Engine ──────────────────────────────────────────────────────
# Download: huggingface.co/TheBloke/Mistral-7B-Instruct-v0.3-GGUF
LLM_MODEL_PATH=./models/mistral-7b-instruct-v0.3.Q4_K_M.gguf
LLM_N_CTX=4096
LLM_N_GPU_LAYERS=0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
MOCK_LLM=true

# ── Embeddings & Reranker ─────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-base
MOCK_EMBEDDINGS=false

# ── RAG Pipeline ──────────────────────────────────────────────────────────────
HYBRID_ALPHA=0.6
RRF_K=60
TOP_K_RETRIEVE=10
TOP_K_RERANK=5

# ── Security ──────────────────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION!
JWT_SECRET=aegis_super_secret_jwt_key_ntro_sih2026_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_AUDIT=10/minute
RATE_LIMIT_UPLOAD=30/minute
