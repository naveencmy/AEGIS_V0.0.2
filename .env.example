# ==============================================================================
# AEGIS-NTRO v2.0.0-RC1 Environment Configuration
# Sovereign AI-Driven Network Compliance Auditor
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_NAME=AEGIS-NTRO
VERSION=2.0.0-rc1
DEBUG=true

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegis_ntro
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secure_pass_2026@localhost:5432/aegis_ntro

# LLM Reasoning Engine Configuration
LLM_MODEL_PATH=./models/mistral-7b-instruct-v0.3.Q4_K_M.gguf
LLM_THREADS=4
LLM_CONTEXT_WINDOW=4096
LLM_GPU_LAYERS=0
MOCK_LLM=true

# Embedding & Re-ranking Models
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_MODEL=BAAI/bge-reranker-base

# Security & Authentication
JWT_SECRET=aegis_super_secret_jwt_key_ntro_sih2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Worker & Queue
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
